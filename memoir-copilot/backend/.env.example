# Memoir Copilot Backend
# 复制本文件为 .env 后填写密钥：  cp .env.example .env

# ---------- 必改（本地安全） ----------
APP_ENV=dev
APP_NAME=memoir-copilot
SECRET_KEY=change-me-dev-secret-key-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ---------- 数据库 / 队列（本机默认；Docker Compose 会覆盖为容器内主机名） ----------
DATABASE_URL=postgresql+asyncpg://memoir:memoir@localhost:5432/memoir
DATABASE_URL_SYNC=postgresql+psycopg://memoir:memoir@localhost:5432/memoir
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!

# ---------- 选填：对象存储（不填则媒体存本地 backend/.data/media） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# ---------- 填了就能用实时字幕：腾讯云实时 ASR ----------
# 控制台开通「语音识别」→ API 密钥管理 获取 AppID / SecretId / SecretKey
# 文档：https://cloud.tencent.com/document/product/1093/48982
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_APP_ID=

# ---------- 填了就能用现场 AI 分析：OpenAI 兼容接口 ----------
# 不填时分析会静默 stub（不报错但不会真正抽取）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

WINDOW_ANALYZER_MODEL=gpt-4o-mini
GLOBAL_ANALYZER_MODEL=gpt-4o-mini
FINAL_REVIEW_MODEL=gpt-4o
TRANSCRIPT_CLEANER_MODEL=gpt-4o-mini
THIRD_OPINION_ASR_MODEL=gpt-4o-transcribe
WATCH_ASR_MODEL=gpt-4o-transcribe

LLM_SOFT_LIMIT_USD=2.0
LLM_HARD_LIMIT_USD=5.0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# Docker 内可选：MEMOIR_SEEDS_DIR=/app/seeds
MEMOIR_SEEDS_DIR=
