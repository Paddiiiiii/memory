# Memoir Copilot Backend — copy to .env

APP_ENV=dev
APP_NAME=memoir-copilot
SECRET_KEY=change-me-dev-secret-key-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DATABASE_URL=postgresql+asyncpg://memoir:memoir@localhost:5432/memoir
DATABASE_URL_SYNC=postgresql+psycopg://memoir:memoir@localhost:5432/memoir
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!

COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_APP_ID=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

WINDOW_ANALYZER_MODEL=gpt-5.6-luna
GLOBAL_ANALYZER_MODEL=gpt-5.6-terra
FINAL_REVIEW_MODEL=gpt-5.6-sol
TRANSCRIPT_CLEANER_MODEL=gpt-5.6-terra
THIRD_OPINION_ASR_MODEL=gpt-4o-transcribe
WATCH_ASR_MODEL=gpt-transcribe

LLM_SOFT_LIMIT_USD=2.0
LLM_HARD_LIMIT_USD=5.0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
